---
interface Props {
  title: string;
  href: string;
  summary: string;
  year?: number;
  coverImage?: string;
  purchaseUrl?: string;
  featured?: boolean;
}

const { title, href, summary, year, coverImage, purchaseUrl, featured } =
  Astro.props;
---

<article class={`novel-card ${featured ? 'novel-card--featured' : ''}`}>
  {coverImage && (
    <a class="novel-card__cover" href={href} tabindex="-1" aria-hidden="true">
      <img src={coverImage} alt="" width="240" height="360" loading="lazy" />
    </a>
  )}
  <div class="novel-card__body">
    {featured && <span class="badge">Destacada</span>}
    <h3 class="novel-card__title">
      <a href={href}>{title}</a>
    </h3>
    {year && <p class="novel-card__year">{year}</p>}
    <p class="novel-card__summary">{summary}</p>
    <div class="novel-card__actions">
      <a class="novel-card__read" href={href}>Sinopsis</a>
      {purchaseUrl && (
        <a
          class="btn btn--primary novel-card__buy"
          href={purchaseUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Comprar
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .novel-card {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--spacing-lg);
    padding: var(--spacing-lg);
    background: var(--color-paper-elevated);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    transition: box-shadow 0.25s, border-color 0.25s;
  }

  .novel-card:hover {
    border-color: var(--color-border);
    box-shadow: var(--shadow-soft);
  }

  .novel-card--featured {
    border-color: color-mix(in srgb, var(--color-accent-gold) 35%, var(--color-border));
  }

  .novel-card__cover img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border-light);
    box-shadow: 0 4px 16px rgba(28, 25, 23, 0.08);
  }

  .novel-card__cover {
    border: none;
    text-decoration: none;
  }

  .novel-card__title {
    margin: 0 0 var(--spacing-sm);
    font-size: var(--font-size-h3);
  }

  .novel-card__title a {
    text-decoration: none;
    color: var(--color-ink);
    border: none;
  }

  .novel-card__title a:hover {
    color: var(--color-accent-terracotta);
  }

  .novel-card__year {
    margin: 0 0 var(--spacing-md);
    font-size: var(--font-size-sm);
    color: var(--color-ink-soft);
  }

  .novel-card__summary {
    margin: 0 0 var(--spacing-lg);
    color: var(--color-ink-muted);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .novel-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    align-items: center;
  }

  .novel-card__read {
    font-weight: 600;
    font-size: var(--font-size-sm);
    text-decoration: none;
    border: none;
  }

  .novel-card__buy {
    padding: 0.45rem 0.9rem;
    font-size: var(--font-size-xs);
  }

  @media (max-width: 640px) {
    .novel-card {
      grid-template-columns: 1fr;
    }

    .novel-card__cover {
      max-width: 9rem;
    }
  }
</style>
