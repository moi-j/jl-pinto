---
// Article card component for archive listings
// Displays title, summary, date, and read-time estimate
// Keyboard accessible with semantic markup

export interface Props {
  title: string;
  href: string;
  summary: string;
  publishedDate?: Date;
  wordCount?: number;
  featured?: boolean;
}

const { 
  title, 
  href, 
  summary, 
  publishedDate,
  wordCount = 1000,
  featured = false
} = Astro.props;

// Calculate read time (average 200 words per minute)
const readTime = Math.ceil(wordCount / 200);

// Format date in Spanish
const formatter = new Intl.DateTimeFormat('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedDate = publishedDate ? formatter.format(publishedDate) : null;
---

<article class={`article-card ${featured ? 'featured' : ''}`}>
  {featured && (
    <span class="featured-badge" aria-label="Artículo destacado">
      Destacado
    </span>
  )}
  
  <h3 class="article-title">
    <a href={href}>{title}</a>
  </h3>
  
  <p class="article-summary">{summary}</p>
  
  <div class="article-meta">
    {formattedDate && (
      <time datetime={publishedDate?.toISOString()}>
        {formattedDate}
      </time>
    )}
    {wordCount > 0 && (
      <>
        <span class="separator">·</span>
        <span class="read-time">{readTime} min de lectura</span>
      </>
    )}
  </div>
  
  <a href={href} class="read-more">Leer más →</a>
</article>

<style>
  .article-card {
    padding: var(--spacing-xl);
    border: 1px solid var(--color-border-light);
    background: var(--color-paper-elevated);
    border-radius: var(--radius-sm);
    transition: box-shadow 0.25s, border-color 0.25s;
    position: relative;
  }

  .article-card:hover {
    border-color: var(--color-border);
    box-shadow: var(--shadow-soft);
  }

  .featured {
    border-color: color-mix(in srgb, var(--color-accent-gold) 40%, var(--color-border));
  }

  .featured-badge {
    display: inline-block;
    background: var(--color-accent-terracotta);
    color: white;
    padding: var(--spacing-xs) var(--spacing-sm);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: var(--spacing-md);
    border-radius: 2px;
  }

  .article-title {
    margin: 0 0 var(--spacing-md) 0;
    font-size: var(--font-size-h4);
    line-height: var(--line-height-heading);
  }

  .article-title a {
    border: none;
    color: var(--color-ink);
    text-decoration: none;
    transition: color 0.2s;
  }

  .article-title a:hover {
    color: var(--color-accent-terracotta);
  }

  .article-title a:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .article-summary {
    color: var(--color-ink-muted);
    line-height: 1.7;
    margin: 0 0 var(--spacing-lg) 0;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: var(--font-size-sm);
    color: var(--color-ink-soft);
    margin-bottom: var(--spacing-lg);
  }

  .separator {
    opacity: 0.4;
  }

  .read-more {
    display: inline-block;
    color: var(--color-accent-terracotta);
    text-decoration: none;
    font-weight: 500;
    border: none;
    padding: var(--spacing-sm) 0;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s;
  }

  .read-more:hover {
    border-bottom-color: var(--color-accent-warm);
  }

  .read-more:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    .article-card {
      padding: var(--spacing-lg);
    }

    .article-title {
      font-size: var(--font-size-h5);
    }
  }
</style>
