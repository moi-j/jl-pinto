---
interface Props {
  title?: string;
  tagline: string;
  intro: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  title = 'Juan Luis Pinto',
  tagline,
  intro,
  imageSrc = '/images/author/jlpinto.jpg',
  imageAlt = 'Retrato de Juan Luis Pinto',
} = Astro.props;
---

<section class="hero container">
  <div class="hero__copy">
    <p class="hero__eyebrow">Escritor · Málaga</p>
    <h1 class="hero__title">{title}</h1>
    <p class="hero__tagline">{tagline}</p>
    <p class="hero__intro">{intro}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/sobre-mi/">Conocer al autor</a>
      <a class="btn btn--secondary" href="/novelas/">Explorar novelas</a>
    </div>
  </div>
  <figure class="hero__figure">
    <img src={imageSrc} alt={imageAlt} width="918" height="822" loading="eager" />
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--spacing-3xl);
    align-items: center;
    padding: var(--spacing-3xl) var(--container-padding);
    max-width: var(--max-width-wide);
    margin: 0 auto;
  }

  .hero__eyebrow {
    margin: 0 0 var(--spacing-sm);
    font-size: var(--font-size-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 600;
  }

  .hero__title {
    margin-bottom: var(--spacing-md);
  }

  .hero__tagline {
    margin: 0 0 var(--spacing-lg);
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-style: italic;
    color: var(--color-ink-muted);
  }

  .hero__intro {
    max-width: 38rem;
    margin-bottom: var(--spacing-xl);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }

  .hero__figure {
    margin: 0;
  }

  .hero__figure img {
    display: block;
    width: 100%;
    max-width: 26rem;
    height: auto;
    margin-inline: auto;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: var(--spacing-2xl);
    }

    .hero__figure {
      order: -1;
    }

    .hero__figure img {
      max-width: 18rem;
    }
  }
</style>
