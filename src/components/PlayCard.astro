---
interface Props {
  title: string;
  href: string;
  summary: string;
  year?: number;
  awards?: string[];
  coverImage?: string;
}

const { title, href, summary, year, awards = [], coverImage } = Astro.props;
---

<article class="play-card">
  {coverImage && (
    <a class="play-card__cover" href={href} tabindex="-1" aria-hidden="true">
      <img src={coverImage} alt="" width="320" height="450" loading="lazy" />
    </a>
  )}
  <h3 class="play-card__title">
    <a href={href}>{title}</a>
  </h3>
  {year && <p class="play-card__year">{year}</p>}
  <p class="play-card__summary">{summary}</p>
  {awards.length > 0 && (
    <ul class="play-card__awards" aria-label="Premios">
      {awards.map((award) => (
        <li><span class="badge">{award}</span></li>
      ))}
    </ul>
  )}
  <a class="play-card__link" href={href}>Ver obra →</a>
</article>

<style>
  .play-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: var(--spacing-lg);
    background: var(--color-paper-elevated);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    transition: box-shadow 0.25s, border-color 0.25s;
  }

  .play-card:hover {
    border-color: var(--color-border);
    box-shadow: var(--shadow-soft);
  }

  .play-card__cover {
    display: block;
    margin: calc(-1 * var(--spacing-lg)) calc(-1 * var(--spacing-lg)) var(--spacing-md);
    border: none;
    text-decoration: none;
    overflow: hidden;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }

  .play-card__cover img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-bottom: 1px solid var(--color-border-light);
  }

  .play-card__title {
    margin: 0 0 var(--spacing-sm);
    font-size: 1.35rem;
  }

  .play-card__title a {
    text-decoration: none;
    color: var(--color-ink);
    border: none;
  }

  .play-card__title a:hover {
    color: var(--color-accent-terracotta);
  }

  .play-card__year {
    margin: 0 0 var(--spacing-md);
    font-size: var(--font-size-sm);
    color: var(--color-ink-soft);
  }

  .play-card__summary {
    flex: 1;
    margin: 0 0 var(--spacing-lg);
    color: var(--color-ink-muted);
    line-height: 1.65;
    font-size: var(--font-size-sm);
  }

  .play-card__awards {
    list-style: none;
    margin: 0 0 var(--spacing-md);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }

  .play-card__link {
    font-weight: 600;
    font-size: var(--font-size-sm);
    text-decoration: none;
    border: none;
  }
</style>
