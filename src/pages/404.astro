---
import SiteLayout from '../components/SiteLayout.astro';
---

<SiteLayout
  title="Página no encontrada — Juan Luis Pinto"
  description="La página solicitada no existe en el sitio de Juan Luis Pinto."
>
  <section class="container error-page">
    <p class="error-page__code">404</p>
    <h1>Página no encontrada</h1>
    <p>
      La ruta que buscas no existe o ha cambiado. Puedes volver al inicio o
      explorar artículos, novelas y obras de teatro desde los enlaces de abajo.
    </p>
    <div class="error-page__actions">
      <a class="btn btn--primary" href="/">Ir al inicio</a>
    </div>
    <nav class="error-page__links" aria-label="Enlaces útiles">
      <a href="/articulos/">Artículos</a>
      <a href="/novelas/">Novelas</a>
      <a href="/teatro/">Teatro</a>
      <a href="/sobre-mi/">Sobre mí</a>
    </nav>
  </section>
</SiteLayout>

<style>
  .error-page {
    padding: var(--spacing-4xl) var(--container-padding);
    max-width: 36rem;
    text-align: center;
  }

  .error-page__code {
    margin: 0 0 var(--spacing-sm);
    font-family: var(--font-serif);
    font-size: 4rem;
    line-height: 1;
    color: var(--color-accent-gold);
  }

  .error-page__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-md);
    margin: var(--spacing-2xl) 0;
  }

  .error-page__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-lg);
    font-size: var(--font-size-sm);
  }

  .error-page__links a {
    text-decoration: none;
    font-weight: 600;
    border: none;
  }
</style>
